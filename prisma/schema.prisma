generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  FREE
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  VERIFYING
  PAID
  REJECTED
  EXPIRED
}

enum PaymentToken {
  USDT
  USDC
}

enum DeviceStatus {
  ACTIVE
  BLOCKED
  UNBOUND
}

enum ExchangeCategory {
  CEX
  DEX
  OTHER
}

enum AnnouncementType {
  NOTICE
  MAINTENANCE
  UPDATE
  ACTIVITY
}

model User {
  id           String          @id @default(cuid())
  username     String          @unique
  email        String?         @unique
  passwordHash String          @map("password_hash")
  recoveryHash String?         @map("recovery_hash")
  role         UserRole        @default(USER)
  isOwner      Boolean         @default(false) @map("is_owner")
  status       UserStatus      @default(ACTIVE)
  sessionVersion Int           @default(0) @map("session_version")
  deletedAt    DateTime?       @map("deleted_at")
  lastLoginAt  DateTime?       @map("last_login_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  ipRecords    IpRecord[]
  logs         OperationLog[]
  membership   Membership?
  orders       Order[]
  devices      Device[]
  announcements Announcement[] @relation("AnnouncementCreator")

  @@map("users")
}

model MembershipPlan {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  description      String?
  priceUsd         Decimal      @map("price_usd") @db.Decimal(10, 2)
  durationDays     Int          @default(30) @map("duration_days")
  durationMonths   Int          @default(1) @map("duration_months")
  queryLimit       Int?         @map("query_limit")
  unlimitedHistory Boolean      @default(false) @map("unlimited_history")
  features         Json
  active           Boolean      @default(true)
  sortOrder        Int          @default(0) @map("sort_order")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  memberships      Membership[]
  orders           Order[]

  @@index([active, sortOrder])
  @@map("membership_plans")
}

model Membership {
  id         String           @id @default(cuid())
  userId     String           @unique @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId     String           @map("plan_id")
  plan       MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status     MembershipStatus @default(FREE)
  startsAt   DateTime?        @map("starts_at")
  expiresAt  DateTime?        @map("expires_at")
  reminderAt DateTime?        @map("reminder_at")
  queryLimit Int?             @map("query_limit")
  queryUsed  Int              @default(0) @map("query_used")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@map("memberships")
}

model Order {
  id               String          @id @default(cuid())
  orderNo          String          @unique @map("order_no")
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId           String          @map("plan_id")
  plan             MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           OrderStatus     @default(PENDING)
  paymentToken     PaymentToken    @map("payment_token")
  chain            String          @default("BSC")
  amount           Decimal         @db.Decimal(10, 2)
  receivingAddress String          @map("receiving_address")
  payerAddress     String?         @map("payer_address")
  txHash           String?         @unique @map("tx_hash")
  confirmations    Int             @default(0)
  failureReason    String?         @map("failure_reason")
  expiresAt        DateTime        @map("expires_at")
  paidAt           DateTime?       @map("paid_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([paymentToken])
  @@map("orders")
}

model Device {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceId        String       @unique @map("device_id")
  fingerprintHash String       @map("fingerprint_hash")
  browser         String?
  os              String?
  userAgent       String?      @map("user_agent")
  ipAddress       String?      @map("ip_address")
  status          DeviceStatus @default(ACTIVE)
  boundAt         DateTime?    @map("bound_at")
  firstSeenAt     DateTime     @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime     @default(now()) @map("last_seen_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([userId, fingerprintHash])
  @@index([userId, status])
  @@index([fingerprintHash])
  @@map("devices")
}

model Exchange {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String           @unique
  category  ExchangeCategory
  iconUrl   String?          @map("icon_url")
  active    Boolean          @default(true)
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([category, active, sortOrder])
  @@map("exchanges")
}

model Announcement {
  id          String           @id @default(cuid())
  title       String
  content     String
  type        AnnouncementType @default(NOTICE)
  active      Boolean          @default(true)
  popup       Boolean          @default(false)
  publishedAt DateTime         @default(now()) @map("published_at")
  expiresAt   DateTime?        @map("expires_at")
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([active, publishedAt])
  @@map("announcements")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model IpRecord {
  id          String   @id @default(cuid())
  fullIp      String   @map("full_ip")
  segmentA    Int      @map("segment_a")
  segmentB    Int      @map("segment_b")
  segmentC    Int      @map("segment_c")
  segmentD    Int      @map("segment_d")
  exchange    String
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  queryCount  Int      @default(1) @map("query_count")
  lastSimilarity Int   @default(0) @map("last_similarity")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([fullIp, exchange], name: "ip_records_full_ip_exchange_key")
  @@index([fullIp])
  @@index([segmentA])
  @@index([segmentB])
  @@index([segmentC])
  @@index([segmentD])
  @@index([exchange])
  @@index([userId])
  @@index([lastSimilarity])
  @@index([createdAt])
  @@map("ip_records")
}

model OperationLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  detail     Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
  @@map("operation_logs")
}
